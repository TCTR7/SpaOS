# =========================================================
# SpaOS Monorepo Root .gitignore
# =========================================================

# Environment variables & Secrets (keep *.env.example)
.env
.env.*
!.env.example
!frontend/.env.example

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node.js / Next.js Frontend
node_modules/
.next/
/frontend/.next-qa/
/frontend/.qa/
/automation_test/artifacts/qa/
out/
.vercel/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Docker & Databases
postgres_data/
*.sql.gz
*.db
*.sqlite3

# IDEs & OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*.swo
*.log

# Local database recovery artifacts (contain customer data)
/backups/
*.dump
