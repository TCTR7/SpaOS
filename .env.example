# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=spaos
POSTGRES_PASSWORD=spaos_password
POSTGRES_DB=spaos
POSTGRES_PORT=5432
APP_DB_USER=spaos_app
APP_DB_PASSWORD=spaos_app_password
BACKEND_PORT=8000

# --- Backend ---
# Runtime: role KHÔNG phải superuser (RLS có hiệu lực)
DATABASE_URL=postgresql+asyncpg://spaos_app:spaos_app_password@localhost:5432/spaos
# Alembic migration: role owner
MIGRATION_DATABASE_URL=postgresql+asyncpg://spaos:spaos_password@localhost:5432/spaos

JWT_SECRET_KEY=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# --- Web Push (VAPID) - sinh khoa: docker compose exec backend python -m app.generate_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@spaos.local

# Deployment rieng: moi khach hang dung project/DB/volume/domain/secrets rieng
# Chay: docker-compose --env-file .env.client-a -p spaos-client-a up -d
ENVIRONMENT=development
ALLOW_TENANT_REGISTRATION=false
BRAND_NAME=SpaOS
# Production: ENVIRONMENT=production; giu ALLOW_TENANT_REGISTRATION=false.
# Khoi tao lan dau bang CLI scripts/bootstrap_deployment.py, khong mo dang ky cong khai.

# Tai khoan rieng cua don vi trien khai; khong co mat khau mac dinh
OPERATOR_PHONE=
OPERATOR_NAME=Quan tri trien khai
# It nhat 12 ky tu, toi da 72 byte UTF-8; dat rieng moi deployment, khong commit file secrets
OPERATOR_PASSWORD=
# Backend se seed duy nhat tai khoan nay khi khoi dong neu da cau hinh.
